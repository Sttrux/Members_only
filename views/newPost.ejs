<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="./css/newPost.css" />
    <link rel="stylesheet" href="./css/header.css" />
    <link rel="stylesheet" href="./css/footer.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:wght@100..900&family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="./images/icon.png" />

    <title>Sub-Redit</title>
  </head>

  <body>
      <%- include("header", { user: user }) %>
    <main>
        <h1 id="post-letters">Write a new post!</h1>
        <form action="/new-post" method="post">
            <label for="title">Title:</label>
            <input type="text" name="title" id="title">
            <label for="text">Text:</label>
            <textarea name="text" id="text"></textarea>
            <button type="submit">Save</button>
        </form>
    </main>
    <%- include("footer")%>
  </body>
</html>
